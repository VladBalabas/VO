__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.env
.idea/
AGENTS.md

# Generated load-test payloads are kept locally; individual raw JSON files can
# exceed GitHub's 100 MiB limit. Compact analyses, evidence and figures remain
# versioned. README files document how to reproduce and verify the omitted raw.
/results/lab2/
/results/lab2_final/raw/*
!/results/lab2_final/raw/README.md
!/results/lab2_final/raw/n1_profile.json.gz
!/results/lab2_final/raw/n2_profile.json.gz
!/results/lab2_final/raw/n3_profile.json.gz
!/results/lab2_final/raw/n4_profile.json.gz
/results/lab2_excluded_no_drain/*
!/results/lab2_excluded_no_drain/README.md

# Lab 3 uncompressed JSON Lines stay local. Deterministic .jsonl.gz packages
# for all experiment runs except the large noop control are versioned.
/results/lab3_final/raw/*.jsonl

# ЛР4: первинні JSONL зберігаються локально, детерміновані gzip-копії версіонуються.
/results/lab4_final/runs/*/*.jsonl

